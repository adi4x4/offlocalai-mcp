# offlocal.ai provider credentials. Copy to `.env` and fill in the providers you use.
# These are read at call time and NEVER written to .offlocal/.
# Set them in your MCP client's `env` block (preferred) or your shell.

# Optional: stale file-lock threshold for .offlocal/state.json and memory.json.
# Defaults to 30000 ms. Increase if your filesystem is unusually slow.
OFFLOCAL_LOCK_STALE_MS=30000

# Optional: provider API request timeout.
# Defaults to 30000 ms. Must be a positive integer.
OFFLOCAL_HTTP_TIMEOUT_MS=30000
# Optional: retry idempotent provider reads on 429/5xx/network failures.
OFFLOCAL_HTTP_RETRIES=2
OFFLOCAL_HTTP_RETRY_BASE_MS=25

# Optional: cap retained local memory/audit entries. Unset means unlimited.
OFFLOCAL_MEMORY_MAX_ENTRIES=
OFFLOCAL_AUDIT_MAX_ENTRIES=

# Optional: emit structured CLI startup logs to stderr. MCP server logs are always stderr JSONL.
OFFLOCAL_LOG_STARTUP=false

# DashClaw authoritative governance gate for risky provider actions.
# Reads can proceed without DashClaw; writes/deploys/env changes/live/destructive actions fail closed.
DASHCLAW_BASE_URL=
DASHCLAW_API_KEY=
DASHCLAW_TIMEOUT_MS=30000
OFFLOCAL_DASHCLAW_MODE=authoritative

# GitHub — fine-grained PAT (Metadata: read, Contents: read; add Contents: write for writes)
GITHUB_TOKEN=

# Vercel — account/team token
VERCEL_TOKEN=
# Optional: required for team-owned resources
VERCEL_TEAM_ID=

# Supabase — personal access token
SUPABASE_ACCESS_TOKEN=

# Stripe — separate test and live secret keys (mode is determined by the key prefix)
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Railway — account/workspace token
RAILWAY_TOKEN=

# Neon — API key from console.neon.tech -> Account settings -> API keys
NEON_API_KEY=neon_api_key_here

# Namecheap — enable API access at Profile -> Tools -> API Access (eligibility applies).
# NAMECHEAP_CLIENT_IP must be this machine's CURRENT public IP (curl ifconfig.me)
# and the SAME IP must be whitelisted in API Access. Re-whitelist on error 1011102.
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=namecheap_api_key_here
NAMECHEAP_CLIENT_IP=203.0.113.7
# true targets api.sandbox.namecheap.com (separate signup at sandbox.namecheap.com).
# Recommended until your account is enabled and you are ready to spend real money.
NAMECHEAP_SANDBOX=true
